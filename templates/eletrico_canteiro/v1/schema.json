{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemorialEletricoCanteiroContextV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["documento", "obra", "energia", "mt", "aterramento", "equipamentos", "quadros"],
  "properties": {
    "documento": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_atual"],
      "properties": {
        "data_atual": {"type": "string", "description": "Data exibida na capa do memorial"}
      }
    },
    "obra": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numero_cadastro",
        "construtora",
        "nome",
        "localizacao",
        "porcentagem_entre_trafos",
        "porcentagem_entre_quadros"
      ],
      "properties": {
        "numero_cadastro": {"type": "string"},
        "construtora": {"type": "string"},
        "nome": {"type": "string"},
        "localizacao": {"type": "string"},
        "porcentagem_entre_trafos": {"type": "string"},
        "porcentagem_entre_quadros": {"type": "string"}
      }
    },
    "energia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tem_subestacao"],
      "properties": {
        "tem_subestacao": {"type": "boolean"},
        "tipo_subestacao": {"type": ["string", "null"]},
        "potencia_transformador_kva": {"type": ["number", "null"]},
        "tap_descricao": {"type": ["string", "null"]},
        "tensao_secundaria": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"tem_subestacao": {"const": true}},
            "required": ["tem_subestacao"]
          },
          "then": {
            "required": [
              "tipo_subestacao",
              "potencia_transformador_kva",
              "tap_descricao",
              "tensao_secundaria"
            ]
          }
        }
      ]
    },
    "mt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tensao_kv"],
      "properties": {
        "tensao_kv": {"type": "number"},
        "diametro_eletroduto_pol": {"type": ["number", "null"]},
        "secao_cabo_mm2": {"type": ["number", "null"]},
        "tipo_cabo": {"type": ["string", "null"]},
        "temperatura_cabo": {"type": ["number", "null"]},
        "classe_isolacao": {"type": ["string", "null"]}
      }
    },
    "aterramento": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo_sistema", "qtd_hastes", "secao_cabo_cobre_mm2"],
      "properties": {
        "tipo_sistema": {"type": "string", "enum": ["TN-S", "TN-C", "TN-C-S", "TT", "IT"]},
        "qtd_hastes": {"type": "integer", "minimum": 1},
        "secao_cabo_cobre_mm2": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "equipamentos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nome", "potencia", "qtd"],
        "properties": {
          "nome": {"type": "string", "minLength": 1},
          "potencia": {"type": ["string", "null"]},
          "qtd": {"type": "integer", "minimum": 1}
        }
      }
    },
    "quadros": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nome", "carga_w", "carga_formatada", "descricao"],
        "properties": {
          "nome": {"type": "string", "minLength": 1},
          "carga_w": {"type": "number", "exclusiveMinimum": 0},
          "carga_formatada": {"type": "string"},
          "descricao": {"type": ["string", "null"]}
        }
      }
    }
  }
}
